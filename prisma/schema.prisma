generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model agenda {
  id Int @id @default(autoincrement())
  descricao String
  funcionarioId Int
  funcionario funcionario @relation("FuncionarioId", fields: [funcionarioId], references: [id])
  clienteId Int?
  cliente cliente? @relation("ClienteId", fields: [clienteId], references: [id])
  tipoAgendaId Int
  tipoAgenda tipoAgenda @relation("TipoAgendaId", fields: [tipoAgendaId], references: [id])
  horaInicio DateTime 
  horaFim DateTime
  // etapa da triagem: agendado | liberado | em_andamento | concluido
  status String @default("agendado")
  // horários reais, gravados ao iniciar e ao concluir a etapa
  inicioReal DateTime?
  fimReal DateTime?
  // fim combinado originalmente; preenchido quando a etapa termina antes e libera o resto do horário
  horaFimPrevista DateTime?

  @@index([funcionarioId, horaInicio])
  @@index([clienteId, horaInicio])

  @@map("agendas")
}

model funcionario {
  id Int @id @default(autoincrement())
  descricao String
  // serviços que a profissional atende (ex.: Manicure e Cabelo)
  especialidades tipoAgenda[] @relation("Especialidades")
  agenda agenda[] @relation("FuncionarioId")
}

model cliente {
  id Int @id @default(autoincrement())
  descricao String
  telefone String?
  dataNascimento DateTime?
  agenda agenda[] @relation("ClienteId")
}

model tipoAgenda {
  id Int @id @default(autoincrement())
  descricao String
  agenda agenda[] @relation("TipoAgendaId")
  profissionais funcionario[] @relation("Especialidades")
}