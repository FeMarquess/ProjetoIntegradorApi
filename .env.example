# Banco usado pela API
DATABASE_URL="postgresql://usuario:senha@localhost:5432/salao"

# Banco SÓ para os testes de integração (é apagado a cada teste). Nunca use o banco de produção aqui.
DATABASE_URL_TESTE="postgresql://usuario:senha@localhost:5432/salao_teste"

